# Fins de ligne : LF partout, sauf scripts PowerShell
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binaires éventuels (fixtures) via Git LFS si configuré
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Vendored third-party code is pinned by hash: never normalise it
templates/game-web/vendor/** -text
