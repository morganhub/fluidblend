{
  "$id": "https://fluidblend.local/schemas/rig-profile.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controls": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Controls",
      "type": "object"
    },
    "instance_id": {
      "title": "Instance Id",
      "type": "string"
    },
    "missing_controls": {
      "items": {
        "type": "string"
      },
      "title": "Missing Controls",
      "type": "array"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "unsupported_operations": {
      "items": {
        "type": "string"
      },
      "title": "Unsupported Operations",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "controls",
    "source_sha256",
    "instance_id"
  ],
  "title": "RigProfile",
  "type": "object"
}
