{
  "$id": "https://fluidblend.local/schemas/operations/scene.checkpoint.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Snapshot of the current work file",
  "properties": {
    "label": {
      "default": "manual",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "title": "Label",
      "type": "string"
    }
  },
  "title": "SceneCheckpointParams",
  "type": "object",
  "x-fluidblend": {
    "available": true,
    "backend": "host",
    "cli_command": null,
    "input_paths": [],
    "live_dependencies": [
      "blender.mcp_live",
      "blender.runtime_addon"
    ],
    "lot": "P0",
    "modes": [
      "batch",
      "live"
    ],
    "op_class": "write",
    "optional_dependencies": [],
    "publication": "reports_and_artifacts",
    "required_dependencies": [],
    "required_targets": [
      "shot_id"
    ],
    "requires_shot": true
  }
}
