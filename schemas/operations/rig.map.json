{
  "$id": "https://fluidblend.local/schemas/operations/rig.map.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Semantic mapping of a rig",
  "properties": {
    "controls": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Controls",
      "type": "object"
    },
    "inspection_path": {
      "title": "Inspection Path",
      "type": "string"
    },
    "profile_id": {
      "const": "rigify/0.6.10",
      "default": "rigify/0.6.10",
      "title": "Profile Id",
      "type": "string"
    }
  },
  "required": [
    "inspection_path"
  ],
  "title": "RigMapParams",
  "type": "object",
  "x-fluidblend": {
    "available": true,
    "backend": "host",
    "cli_command": null,
    "input_paths": [
      "inspection_path"
    ],
    "live_dependencies": [],
    "lot": "P1",
    "modes": [
      "batch"
    ],
    "op_class": "write",
    "optional_dependencies": [],
    "publication": "reports_and_artifacts",
    "required_dependencies": [],
    "required_targets": [
      "shot_id",
      "instance_id"
    ],
    "requires_shot": true
  }
}
