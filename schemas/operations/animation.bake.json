{
  "$defs": {
    "FrameRange": {
      "additionalProperties": false,
      "description": "Canonical half-open interval `[start, end_exclusive)`.",
      "properties": {
        "end_exclusive": {
          "maximum": 1000001,
          "minimum": -100000,
          "title": "End Exclusive",
          "type": "integer"
        },
        "start": {
          "maximum": 1000000,
          "minimum": -100000,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end_exclusive"
      ],
      "title": "FrameRange",
      "type": "object"
    }
  },
  "$id": "https://fluidblend.local/schemas/operations/animation.bake.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bake constraints/NLA",
  "properties": {
    "frame_range": {
      "$ref": "#/$defs/FrameRange"
    },
    "output_clip": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Output Clip",
      "type": "string"
    },
    "step": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Step",
      "type": "integer"
    }
  },
  "required": [
    "output_clip",
    "frame_range"
  ],
  "title": "AnimationBakeParams",
  "type": "object",
  "x-fluidblend": {
    "available": true,
    "backend": "blender",
    "cli_command": null,
    "input_paths": [],
    "live_dependencies": [],
    "lot": "P1",
    "modes": [
      "batch"
    ],
    "op_class": "write",
    "optional_dependencies": [],
    "publication": "shot_revision_and_reports",
    "required_dependencies": [
      "blender.batch"
    ],
    "required_targets": [
      "shot_id",
      "instance_id"
    ],
    "requires_shot": true
  }
}
