{
  "$id": "https://fluidblend.local/schemas/operations/game.import_test.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Import an exported GLB into the Godot or web (Three.js) template and check what the engine read",
  "properties": {
    "export_path": {
      "description": "Published .glb from game.export, project-relative",
      "title": "Export Path",
      "type": "string"
    },
    "template": {
      "anyOf": [
        {
          "enum": [
            "godot",
            "web"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "godot = Godot 4.7 template; web = Three.js page in a headless Chrome/Edge; omitted = the project's targets.game_engine (godot when that is none)",
      "title": "Template"
    }
  },
  "required": [
    "export_path"
  ],
  "title": "GameImportTestParams",
  "type": "object",
  "x-fluidblend": {
    "available": true,
    "backend": "host",
    "cli_command": null,
    "input_paths": [
      "export_path"
    ],
    "live_dependencies": [],
    "lot": "P1",
    "modes": [
      "batch"
    ],
    "op_class": "read",
    "optional_dependencies": [
      "game.godot",
      "game.browser"
    ],
    "publication": "reports_and_artifacts",
    "required_dependencies": [],
    "required_targets": [
      "shot_id"
    ],
    "requires_shot": true
  }
}
