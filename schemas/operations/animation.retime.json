{
  "$id": "https://fluidblend.local/schemas/operations/animation.retime.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Slow down or speed up a clip on a variant",
  "properties": {
    "duration_scale": {
      "description": "1.2 = duration x 1.2, therefore slower",
      "exclusiveMinimum": 0.05,
      "maximum": 20,
      "title": "Duration Scale",
      "type": "number"
    },
    "output_variant": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Output Variant",
      "type": "string"
    },
    "preserve_contact_markers": {
      "default": true,
      "title": "Preserve Contact Markers",
      "type": "boolean"
    },
    "preview_samples": {
      "default": 8,
      "description": "Before/after frames rendered with Workbench",
      "maximum": 64,
      "minimum": 0,
      "title": "Preview Samples",
      "type": "integer"
    }
  },
  "required": [
    "duration_scale",
    "output_variant"
  ],
  "title": "AnimationRetimeParams",
  "type": "object",
  "x-fluidblend": {
    "available": true,
    "backend": "blender",
    "cli_command": null,
    "input_paths": [],
    "live_dependencies": [
      "blender.mcp_live",
      "blender.runtime_addon"
    ],
    "lot": "P0",
    "modes": [
      "batch",
      "live"
    ],
    "op_class": "write",
    "optional_dependencies": [],
    "publication": "shot_revision_and_reports",
    "required_dependencies": [
      "blender.batch"
    ],
    "required_targets": [
      "shot_id",
      "instance_id",
      "clip_id"
    ],
    "requires_shot": true
  }
}
