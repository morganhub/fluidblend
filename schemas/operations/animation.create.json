{
  "$defs": {
    "FrameRange": {
      "additionalProperties": false,
      "description": "Canonical half-open interval `[start, end_exclusive)`.",
      "properties": {
        "end_exclusive": {
          "maximum": 1000001,
          "minimum": -100000,
          "title": "End Exclusive",
          "type": "integer"
        },
        "start": {
          "maximum": 1000000,
          "minimum": -100000,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end_exclusive"
      ],
      "title": "FrameRange",
      "type": "object"
    }
  },
  "$id": "https://fluidblend.local/schemas/operations/animation.create.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Create a clip from the library",
  "properties": {
    "amplitude": {
      "default": 0.3,
      "description": "Recipe scale; for walk the stride per cycle is 2 x amplitude metres",
      "maximum": 0.6,
      "minimum": 0,
      "title": "Amplitude",
      "type": "number"
    },
    "frame_range": {
      "$ref": "#/$defs/FrameRange"
    },
    "hand": {
      "default": "right",
      "description": "take_prop / give_prop only",
      "enum": [
        "left",
        "right"
      ],
      "title": "Hand",
      "type": "string"
    },
    "output_clip": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Output Clip",
      "type": "string"
    },
    "preset": {
      "enum": [
        "idle_neutral",
        "walk",
        "turn",
        "look_at",
        "reach",
        "take_prop",
        "give_prop",
        "react"
      ],
      "title": "Preset",
      "type": "string"
    },
    "profile_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Path"
    },
    "prop_instance_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "take_prop: static prop whose primary grip is reached",
      "title": "Prop Instance Id"
    },
    "seed": {
      "default": 0,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "stage": {
      "default": "spline",
      "enum": [
        "blocking",
        "spline",
        "polish"
      ],
      "title": "Stage",
      "type": "string"
    },
    "target_point": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "give_prop: world point the hand extends to, metres",
      "title": "Target Point"
    }
  },
  "required": [
    "preset",
    "output_clip"
  ],
  "title": "AnimationCreateParams",
  "type": "object",
  "x-fluidblend": {
    "available": true,
    "backend": "blender",
    "cli_command": null,
    "input_paths": [
      "profile_path"
    ],
    "live_dependencies": [],
    "lot": "P1",
    "modes": [
      "batch"
    ],
    "op_class": "write",
    "optional_dependencies": [],
    "publication": "shot_revision_and_reports",
    "required_dependencies": [
      "blender.batch"
    ],
    "required_targets": [
      "shot_id",
      "instance_id"
    ],
    "requires_shot": true
  }
}
