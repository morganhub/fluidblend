{
  "$id": "https://fluidblend.local/schemas/operations/scene.build.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Build the demonstration scene of a shot",
  "properties": {
    "frames": {
      "default": 240,
      "maximum": 100000,
      "minimum": 2,
      "title": "Frames",
      "type": "integer"
    },
    "preset": {
      "const": "two_characters_prop",
      "default": "two_characters_prop",
      "title": "Preset",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    }
  },
  "title": "SceneBuildParams",
  "type": "object",
  "x-fluidblend": {
    "available": true,
    "backend": "blender",
    "cli_command": null,
    "input_paths": [],
    "live_dependencies": [],
    "lot": "P0",
    "modes": [
      "batch"
    ],
    "op_class": "write",
    "optional_dependencies": [],
    "publication": "shot_revision_and_reports",
    "required_dependencies": [
      "blender.batch"
    ],
    "required_targets": [
      "shot_id"
    ],
    "requires_shot": true
  }
}
