{
  "$defs": {
    "ProviderRef": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "secret_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of an environment variable, never its value",
          "title": "Secret Ref"
        }
      },
      "required": [
        "provider_id",
        "kind"
      ],
      "title": "ProviderRef",
      "type": "object"
    }
  },
  "$id": "https://fluidblend.local/schemas/providers.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "providers": {
      "items": {
        "$ref": "#/$defs/ProviderRef"
      },
      "title": "Providers",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "ProvidersConfig",
  "type": "object"
}
