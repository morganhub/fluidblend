{
  "$defs": {
    "ClipEvent": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "maximum": 1000001,
          "minimum": -100000,
          "title": "Frame",
          "type": "number"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "frame"
      ],
      "title": "ClipEvent",
      "type": "object"
    },
    "ContactWindow": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "description": "Control point at the window start, in support space (rig object space for the world)",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Anchor",
          "type": "array"
        },
        "control_point": {
          "description": "Evaluated bone whose head is measured",
          "minLength": 1,
          "title": "Control Point",
          "type": "string"
        },
        "effector": {
          "minLength": 1,
          "title": "Effector",
          "type": "string"
        },
        "frame_range": {
          "$ref": "#/$defs/FrameRange"
        },
        "support_instance_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = static world ground",
          "title": "Support Instance Id"
        }
      },
      "required": [
        "effector",
        "control_point",
        "frame_range",
        "anchor"
      ],
      "title": "ContactWindow",
      "type": "object"
    },
    "FrameRange": {
      "additionalProperties": false,
      "description": "Canonical half-open interval `[start, end_exclusive)`.",
      "properties": {
        "end_exclusive": {
          "maximum": 1000001,
          "minimum": -100000,
          "title": "End Exclusive",
          "type": "integer"
        },
        "start": {
          "maximum": 1000000,
          "minimum": -100000,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end_exclusive"
      ],
      "title": "FrameRange",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "description": "A figure with its definition (§16.1); `passed` is None when no tolerance gates it.",
      "properties": {
        "control_point": {
          "minLength": 1,
          "title": "Control Point",
          "type": "string"
        },
        "effector": {
          "minLength": 1,
          "title": "Effector",
          "type": "string"
        },
        "frame_range": {
          "$ref": "#/$defs/FrameRange"
        },
        "kind": {
          "enum": [
            "foot_slide",
            "contact_slide",
            "contact_error",
            "loop_pose",
            "loop_velocity",
            "handoff_jump",
            "handoff_rotation_jump"
          ],
          "title": "Kind",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "sampling_step": {
          "minimum": 1,
          "title": "Sampling Step",
          "type": "integer"
        },
        "space": {
          "minLength": 1,
          "title": "Space",
          "type": "string"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "unit": {
          "enum": [
            "m",
            "m/frame",
            "rad"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "effector",
        "control_point",
        "space",
        "frame_range",
        "sampling_step",
        "value",
        "unit"
      ],
      "title": "Measurement",
      "type": "object"
    }
  },
  "$id": "https://fluidblend.local/schemas/clip.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "amplitude": {
      "anyOf": [
        {
          "maximum": 0.6,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amplitude"
    },
    "clip_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Clip Id",
      "type": "string"
    },
    "contacts": {
      "items": {
        "$ref": "#/$defs/ContactWindow"
      },
      "title": "Contacts",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ClipEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "frame_range": {
      "$ref": "#/$defs/FrameRange"
    },
    "layer": {
      "minLength": 1,
      "title": "Layer",
      "type": "string"
    },
    "limits": {
      "items": {
        "type": "string"
      },
      "title": "Limits",
      "type": "array"
    },
    "loop": {
      "default": false,
      "title": "Loop",
      "type": "boolean"
    },
    "loop_error": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Loop Error"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "owned_channels": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "minItems": 1,
      "title": "Owned Channels",
      "type": "array"
    },
    "preset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preset"
    },
    "repetitions": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repetitions"
    },
    "rig_profile": {
      "minLength": 1,
      "title": "Rig Profile",
      "type": "string"
    },
    "root_motion": {
      "enum": [
        "in_place",
        "root_bone",
        "object"
      ],
      "title": "Root Motion",
      "type": "string"
    },
    "root_motion_channels": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Root Motion Channels",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "slot": {
      "minLength": 1,
      "title": "Slot",
      "type": "string"
    },
    "source_clip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Clip"
    },
    "stage": {
      "anyOf": [
        {
          "enum": [
            "blocking",
            "spline",
            "polish"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "stride_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stride M"
    }
  },
  "required": [
    "clip_id",
    "action",
    "slot",
    "rig_profile",
    "frame_range",
    "root_motion",
    "contacts",
    "events",
    "layer",
    "owned_channels"
  ],
  "title": "ClipManifest",
  "type": "object"
}
