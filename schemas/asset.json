{
  "$id": "https://fluidblend.local/schemas/asset.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "armature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Armature"
    },
    "asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Asset Id",
      "type": "string"
    },
    "blend_path": {
      "title": "Blend Path",
      "type": "string"
    },
    "face_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Semantic face mapping of a character, e.g. charmorph-l3/1; None = no face",
      "title": "Face Profile"
    },
    "grips": {
      "additionalProperties": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "description": "Named grip points in the prop root's local space, metres",
      "title": "Grips",
      "type": "object"
    },
    "kind": {
      "default": "character",
      "enum": [
        "character",
        "prop"
      ],
      "title": "Kind",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "license_path": {
      "title": "License Path",
      "type": "string"
    },
    "objects": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Objects",
      "type": "array"
    },
    "rig_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rig Profile"
    },
    "root_object": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Prop object that carries the instance",
      "title": "Root Object"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "asset_id",
    "version",
    "blend_path",
    "sha256",
    "license",
    "license_path",
    "objects"
  ],
  "title": "AssetManifest",
  "type": "object"
}
