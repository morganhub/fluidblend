{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.11",
        "mcp-for-blender",
        "--host",
        "localhost",
        "--port",
        "9876"
      ],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "UV_PYTHON_PREFERENCE": "only-managed",
        "BLENDER_MCP_SAFE_MODE": "1",
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
